{
  "gateway": {
    "host": "localhost",
    "port": 8080,
    "log_level": "info"
  },
  "services": {
    "filesystem": {
      "enabled": true,
      "adapter": "filesystem",
      "config": {
        "allowed_paths": [".ai/", "evals/"],
        "read_only": false
      }
    },
    "git": {
      "enabled": true,
      "adapter": "git",
      "config": {
        "repo_path": "."
      }
    },
    "github": {
      "enabled": true,
      "adapter": "github",
      "config": {
        "api_token": "${GITHUB_TOKEN}",
        "default_owner": "semernyakov"
      }
    }
  }
}
