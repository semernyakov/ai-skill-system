# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.mdc text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Shell scripts should be executable
*.sh text eol=lf

# Python files
*.py text eol=lf

# Markdown files
*.md text eol=lf
*.mdc text eol=lf

# Configuration files
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.pre-commit-config.yaml text eol=lf

# Generated files
.windsurfrules text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Linguist configuration for GitHub
.gitattributes linguist-generated
.github/ linguist-generated
.cursor/ linguist-generated
.windsurf/ linguist-generated
.idea/ linguist-generated
